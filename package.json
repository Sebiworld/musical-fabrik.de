{
  "name": "www.musical-fabrik.de",
  "description": "ProcessWire-Seite für die Musical-Fabrik",
  "version": "3.3.0",
  "repository": {
    "type": "git",
    "url": "git@gitlab.com:musical-fabrik/musical-fabrik.de.git"
  },
  "author": {
    "name": "Sebastian Schendel",
    "email": "sebastian@musical-fabrik.de",
    "url": "https://www.sebi.dev/"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "npm run dev:legacy && npm run dev:modern",
    "dev:modern": "webpack --config webpack.config.js --mode development --env clear=false",
    "dev:legacy": "webpack --config webpack.config.js --mode development --env browser_env=legacy --env clear=false",
    "watch": "webpack --watch --config webpack.config.js --mode development",
    "dev-server": "webpack-dev-server --watch-poll --config webpack.config.js --mode development --host 0.0.0.0 --public 192.168.100.103.8080",
    "build:legacy": "webpack --config webpack.config.js --mode production --env browser_env=legacy",
    "build:modern": "webpack --config webpack.config.js --mode production --env browser_env=modern --env clear=false",
    "build": "npm run build:legacy && npm run build:modern",
    "deployment": "node ./bin/deployment.js",
    "generate": "node ./bin/svg-generator.js",
    "generate-db": "node ./bin/svg-db-generator.js",
    "generate-command": "node ./bin/svg-command-generator.js",
    "generate-placeholder-table": "node ./bin/svg-placeholder-table-generator.js"
  },
  "dependencies": {
    "@babel/polyfill": "^7.12.1",
    "@ciar4n/izmir": "^1.0.1",
    "@popperjs/core": "^2.11.8",
    "angled-edges": "^2.0.0",
    "animejs": "^3.2.2",
    "basiclightbox": "^5.0.4",
    "bootstrap": "^5.3.3",
    "chartjs-plugin-deferred": "^1.0.2",
    "cookieconsent": "^3.1.1",
    "core-js": "^3.38.1",
    "granim": "^2.0.0",
    "hamburgers": "^1.2.1",
    "hover.css": "^2.3.2",
    "imagesloaded": "^4.1.4",
    "ionicons": "^4.6.3",
    "jquery": "^3.7.1",
    "lazysizes": "^5.3.2",
    "lightgallery": "^2.7.2",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "masonry-layout": "^4.2.2",
    "mediaelement": "^4.2.17",
    "mysql": "^2.18.1",
    "picturefill": "^3.0.3",
    "popper.js": "^1.16.1",
    "progressively": "^1.2.5",
    "rellax": "^1.12.1",
    "starability": "^2.4.0",
    "swiper": "^6.8.4",
    "video.js": "^7.21.6",
    "videojs-youtube": "^2.6.1",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@inquirer/confirm": "^3.2.0",
    "@inquirer/prompts": "^5.5.0",
    "@inquirer/select": "^2.5.0",
    "colors": "^1.4.0",
    "commander": "^7.2.0",
    "inquirer": "^10.2.2",
    "pad": "^3.2.0"
  },
  "browserslist": {
    "legacyBrowsers": [
      "> .25% in DE, not dead",
      "ie >= 10",
      "Safari >= 9"
    ],
    "modernBrowsers": [
      "last 2 Chrome versions",
      "not Chrome < 60",
      "last 2 Safari versions",
      "not Safari < 10.1",
      "Safari >= 10",
      "last 2 iOS versions",
      "not iOS < 10.3",
      "last 2 Firefox versions",
      "not Firefox < 54",
      "last 2 Edge versions",
      "not Edge < 15"
    ]
  },
  "type": "module"
}
