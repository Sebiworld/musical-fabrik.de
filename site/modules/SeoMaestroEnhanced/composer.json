{
  "name": "wanze/seo-maestro-enhanced",
  "description": "Seo Maestro Enhanced allows to easily manage your page's meta data and sitemap.",
  "type": "processwire-module",
  "extra": {
    "installer-name": "SeoMaestroEnhanced"
  },
  "keywords": [
    "processwire",
    "seo",
    "metatags",
    "sitemap"
  ],
  "homepage": "https://github.com/wanze/SeoMaestroEnhanced",
  "license": "MIT",
  "authors": [
    {
      "name": "Stefan Wanzenried",
      "email": "stefan.wanzenried@gmail.com",
      "homepage": "https://github.com/wanze"
    }
  ],
  "require": {
    "php": ">=7.0",
    "composer/installers": "~1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^6"
  },
  "autoload-dev": {
    "psr-4": {
      "SeoMaestroEnhanced\\Test\\": "tests/src/"
    }
  }
}
